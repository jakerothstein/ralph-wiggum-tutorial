# Database connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Flask configuration
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-in-production
FLASK_DEBUG=1

# Vite dev server URL (used by Flask templates in development)
VITE_DEV_SERVER=http://localhost:5173

# --- Paper Comprehension Tutor: GitHub Models (OpenAI-compatible) AI backend ---
# A GitHub PAT with the `models: read` permission.
GITHUB_TOKEN=
# OpenAI-compatible inference endpoint for GitHub Models.
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
# Chat + embedding model ids (provider-prefixed for GitHub Models).
GITHUB_MODELS_CHAT_MODEL=openai/gpt-4o-mini
GITHUB_MODELS_EMBEDDING_MODEL=openai/text-embedding-3-small
# Embedding dimensionality of the chosen embedding model (1536 for text-embedding-3-small).
EMBEDDING_DIMS=1536
# Ingest/retrieval tuning.
MAX_UPLOAD_BYTES=10485760
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=80
RETRIEVAL_TOP_K=5
# When set to 1, use the deterministic in-process fake AI client (no token/network).
# Used by the E2E suite and local development without a GitHub Models token.
USE_FAKE_AI=0
